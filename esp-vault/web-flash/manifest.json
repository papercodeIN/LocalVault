        { "path": "firmware_esp32.bin", "offset": 65536 }
      ]
    },
    {
      "chipFamily": "ESP32-C3",
      "parts": [
        { "path": "firmware_esp32c3.bin", "offset": 0 }
      ]
    },
    {
      "chipFamily": "ESP8266",
      "parts": [
        { "path": "firmware_d1_mini.bin", "offset": 0 }
      ]
    }
  ]
}